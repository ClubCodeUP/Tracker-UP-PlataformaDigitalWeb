# Configuración de Tracker UP API
PROJECT_NAME="Tracker UP API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Seguridad JWT
SECRET_KEY="cambiar-esta-clave-secreta-en-produccion-por-un-hash-aleatorio"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Restricción Institucional UP (RF-01)
INSTITUTIONAL_DOMAIN="@up.edu.pe"
INSTITUTIONAL_EMAIL_REGEX="^[a-zA-Z0-9._%+-]+@up\\.edu\\.pe$"

# Base de Datos (SQLite para desarrollo autocontenido, o PostgreSQL para producción)
DATABASE_URL="sqlite:///./tracker_up.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tracker_up"

