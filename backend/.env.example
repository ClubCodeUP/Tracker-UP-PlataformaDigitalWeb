# =============================================================================
# Tracker UP API — Variables de Entorno (.env)
# =============================================================================
PROJECT_NAME="Tracker UP API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Seguridad y Autenticación JWT
SECRET_KEY="cambiar-esta-clave-secreta-en-produccion-por-un-hash-aleatorio-seguro"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Restricción Institucional UP (RF-01: alumnos y docentes UP)
INSTITUTIONAL_DOMAIN="@alum.up.edu.pe"
INSTITUTIONAL_EMAIL_REGEX="^[a-zA-Z0-9._%+-]+@(alum\\.)?up\\.edu\\.pe$"

# Orígenes Permitidos para CORS (Frontend en Netlify / Vercel / Local)
# Usa "*" para permitir cualquier origen en desarrollo, o separa por comas en producción:
CORS_ORIGINS="*"
# CORS_ORIGINS="https://tracker-up.netlify.app,https://tracker-up.vercel.app,http://localhost:5173"

# =============================================================================
# Base de Datos (SQLite local vs PostgreSQL en Supabase)
# =============================================================================

# 1. Opción Local (SQLite por defecto):
DATABASE_URL="sqlite:///./tracker_up.db"

# 2. Opción Producción / Nube (Supabase PostgreSQL):
# Obtén tu connection string en Supabase: Settings -> Database -> Connection string -> URI
# Ejemplo con Transaction Pooler (recomendado para apps serverless/FastAPI):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"



